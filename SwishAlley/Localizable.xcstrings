    "Camera access is off. You can allow it in the Settings app; the game plays the same without it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi kapalı. Ayarlar uygulamasından açabilirsin; oyun kamera olmadan da aynı oynanır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado. Puedes permitirlo en la app Ajustes; el juego funciona igual sin ella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desligado. Você pode permitir no app Ajustes; o jogo funciona igual sem ela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist aus. Du kannst ihn in der Einstellungen-App erlauben; ohne Kamera spielt sich alles genauso."
          }
        }
      }
    },
